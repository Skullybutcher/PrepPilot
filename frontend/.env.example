# ---------------------------------------------------------------
# PrepPilot Frontend — Environment Variables
# ---------------------------------------------------------------
# Copy this file to .env and fill in values for local development.
# On Vercel, set these as Environment Variables in the project settings.
#
# VITE_API_URL
#   The base URL of the PrepPilot backend API (WITHOUT trailing slash).
#   - Production (Vercel): set to your Render backend URL
#     e.g. VITE_API_URL=https://<your-app>.onrender.com/api
#   - Local development: LEAVE THIS UNSET. The Vite dev server proxies
#     /api → http://localhost:4000 automatically (see vite.config.js).
#     Only set it if you want to point your local frontend at a remote backend.
#
# VITE_SUPABASE_URL
#   Your Supabase project URL (needed for Phase C auth integration).
#   e.g. VITE_SUPABASE_URL=https://xyzabc.supabase.co
#
# VITE_SUPABASE_ANON_KEY
#   Your Supabase project anon (public) key.
#   e.g. VITE_SUPABASE_ANON_KEY=eyJ...

# Uncomment and fill in for production or to override local proxy:
# VITE_API_URL=https://<your-app>.onrender.com/api

# Supabase (needed for auth — Phase C):
# VITE_SUPABASE_URL=https://<project>.supabase.co
# VITE_SUPABASE_ANON_KEY=<anon-key>
