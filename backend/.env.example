# Jira Cloud
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=your_jira_api_token
JIRA_PROJECT_KEY=RPC

# NVIDIA NIM
NIM_API_KEY=your_nvidia_nim_api_key

# FR6 — Weekly rebalancing agent (small structured JSON output)
NIM_REBALANCE_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NIM_REBALANCE_MODEL_FALLBACK=deepseek-ai/deepseek-v4.1-flash

# FR7 — Conversational plan builder (long-context multi-turn reasoning)
NIM_CHAT_MODEL=nvidia/nemotron-3-ultra-550b-a55b
NIM_CHAT_MODEL_FALLBACK=nvidia/nemotron-3-super-120b-a12b

# Local data store (SQLite — Phase 5)
DB_PATH=./data/roadmap.db
