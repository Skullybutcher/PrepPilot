{
  "name": "preppilot-backend",
  "version": "0.1.0",
  "description": "Daily todo generator + Jira sync for placement prep roadmap",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "setup:jira": "node src/scripts/setupJiraProject.js",
    "sync:striver": "node src/scripts/syncStriverToJira.js",
    "scrape:striver": "node src/scripts/scrapeStriverSheet.js",
    "generate:today": "node src/scripts/generateDailyTodos.js",
    "check:weekly": "node src/scripts/weeklyRebalanceCheck.js",
    "test": "node --test src/**/*.test.js"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "express": "5.2.1",
    "node-fetch": "^3.3.2",
    "puppeteer": "^25.5.0"
  },
  "engines": {
    "node": ">=18"
  }
}
